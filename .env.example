# ---- LLM ----
LLM_PROVIDER=gemini            # gemini | grok | mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash  # check ai.google.dev for the current Flash model name
GROK_API_KEY=
GROK_MODEL=grok-3-mini         # check docs.x.ai for the current model name
LLM_TIMEOUT_SECONDS=60

# ---- Offline mode (no API key needed; used by pytest) ----
MOCK_LLM=false
MOCK_FAULT_RATE=0.0            # fraction of first-try SQL the mock deliberately breaks (to exercise repair)

# ---- Embeddings ----
EMBEDDING_PROVIDER=local       # local (offline hashing) | gemini
EMBEDDING_MODEL=gemini-embedding-001   # only used when EMBEDDING_PROVIDER=gemini
EMBEDDING_DIM=384              # only used by the local provider

# ---- Database / RAG ----
DATABASE_URL=sqlite:///./data/database.db
VECTOR_STORE_DIR=./vector_store
TOP_K=5
MAX_REPAIR_ATTEMPTS=3
MAX_RESULT_ROWS=500


